{
  "compilerOptions": {
    "module": "NodeNext",
    "noImplicitAny": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "sourceMap": true,
    "jsx": "preserve",
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "moduleResolution": "nodenext",
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.ts"],
}
